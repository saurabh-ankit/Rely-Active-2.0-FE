# Production Frontend Environment Configuration (.env)

# =============================================================================
# OPTION 1: Relative Path for Nginx Reverse Proxy (RECOMMENDED FOR DOCKER)
# =============================================================================
# This allows the app to work on ANY IP address or Domain without re-building.
VITE_API_BASE_URL=/api/v1
VITE_API_URL=/api/v1
VITE_SOCKET_URL=/
VITE_APP_ENV=production
VITE_FEATURE_FLAGS=

# =============================================================================
# OPTION 2: Direct Server IP / URL (Use if API is hosted on a separate IP/Port)
# =============================================================================
# VITE_API_BASE_URL=http://65.0.43.10:3006/api/v1
# VITE_API_URL=http://65.0.43.10:3006/api/v1
# VITE_SOCKET_URL=http://65.0.43.10:3006
